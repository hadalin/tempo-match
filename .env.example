# https://getsongbpm.com/api
GETSONGBPM_API_KEY=

# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: ISO 3166-1 alpha-2 market for Spotify search when the visitor's country
# (Cloudflare CF-IPCountry header) is unknown (default US)
SPOTIFY_MARKET=

# Optional: false or 0 turns off the Deezer song provider (no key needed; on by default)
DEEZER_ENABLED=

# Optional: false or 0 turns off the ReccoBeats check that skips half- or double-time
# matches, and autoplay random that needs it (no key needed; on by default)
RECCOBEATS_ENABLED=

# Optional: SQLite file that remembers which songs Spotify has, across restarts
# (default songs.db in the working directory; /data/songs.db in the container)
SONG_STORE_PATH=

# Optional: web server port (default 3000)
PORT=
