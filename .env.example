# Collector only: the matcher needs no keys.

# https://getsongbpm.com/api
GETSONGBPM_API_KEY=

# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: ISO 3166-1 alpha-2 market whose Spotify ids are collected and served to visitors from
# every country (default US). Set the same value for both services.
SPOTIFY_MARKET=

# Optional: false or 0 turns off the Deezer song provider (no key needed; on by default)
DEEZER_ENABLED=

# Optional: false or 0 turns off the ReccoBeats check that drops half- or double-time matches and
# spoken-word tracks (no key needed; on by default)
RECCOBEATS_ENABLED=

# Optional: directory of catalog.db, shared by both services (default the working directory;
# /data in the container)
DATA_DIR=

# Optional: matcher only, where it sends dead-song reports and per-country counts once a minute
# (unset: not sent; http://collector:3001 in compose)
COLLECTOR_URL=

# Optional: port (default 3000 for the matcher, 3001 for the collector)
PORT=
